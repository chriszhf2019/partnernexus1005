# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your-gemini-api-key"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://partner.velolabs.top"

# Mock Authentication - Set to false to use real Supabase
VITE_USE_MOCK_AUTH="false"

# Supabase configuration (VITE_ prefix required for Vite)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Resend API Key for email sending (send-invite functionality)
VITE_RESEND_API_KEY="re_..."

# Supabase Edge Function URL for send-invite (if different from default)
VITE_SUPABASE_FUNCTION_URL="https://your-project.supabase.co/functions/v1/send-invite"
